FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
    volScalarFieldValue alpha.water 0
);

regions
(
    boxToCell
    {
        box (-1 -1 0) (-0.5 1 1);
        fieldValues
        (
            volScalarFieldValue alpha.water 1
        );
    }
    /*
    boxToCell
    {
        box (-1 -1 0) (1 1 0.3);
        fieldValues
        (
            volScalarFieldValue alpha.water 1
        );
    }
    */
);


